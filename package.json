{
  "name": "kedai",
  "version": "0.4.0-alpha",
  "private": true,
  "license": "MIT",
  "description": "KedaiAgent —— 通用 LLM 智能体 harness,一键启动的本地智能体运行框架",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm test -w web",
    "build:rs": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1",
    "build:test": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1 -TestOnly",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1 -Tauri",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-portable.ps1",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1 -WithPortable",
    "version:bump": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bump-version.ps1",
    "desktop": "dist\\Kedai-portable\\Kedai.exe",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-all.ps1",
    "check:contract": "node tools/check-contract.mjs",
    "check:arch": "node tools/check-arch.mjs",
    "check:lock": "node tools/check-lock-sync.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:lint": "node tools/check-frontend-lint.mjs",
    "check:tests": "node tools/count-tests.mjs --check",
    "check:doc-claims": "node tools/check-doc-claims.mjs",
    "count:tests": "node tools/count-tests.mjs",
    "hooks:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-hooks.ps1",
    "perf": "node tools/perf-baseline.mjs",
    "inspect:card": "node tools/inspect-card.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.2"
  }
}
